GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_IDS=C123456,C789012
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB=Sheet1
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/company_brain
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=ollama-...
LLM_MODEL=glm-5.2
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2048
LLM_MAX_TOKENS_SYNTHESIS=4096
JWT_SECRET=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=*
RATE_LIMIT=30/minute

# Auth0 (optional — leave disabled to use shared-secret JWT mode)
AUTH0_ENABLED=false
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.company-brain.example
AUTH0_JWKS_CACHE_TTL=3600

# Redis for background job queue (ARQ)
REDIS_URL=redis://localhost:6379/0

# Scheduled ingestion / synthesis (APScheduler, in-process)
SCHEDULE_ENABLED=false
SCHEDULE_INGEST_CRON=0 */6 * * *
SCHEDULE_SYNTHESIS_CRON=30 */6 * * *
SCHEDULE_USER_ID=scheduled

# Gunicorn workers
WEB_CONCURRENCY=4
WORKER_TIMEOUT=120