GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_IDS=C123456,C789012
# DEPRECATED for multi-tenant use: these global credentials are used ONLY by
# the one org bound below (LEGACY_CONNECTOR_ORG_ID). Every other org must
# configure its own connector (admins: PUT /api/v1/orgs/{org_id}/connectors/...).
# Leave empty to authorize nobody (recommended for multi-tenant deployments).
LEGACY_CONNECTOR_ORG_ID=
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB=Sheet1
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/company_brain
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=ollama-...
LLM_MODEL=glm-5.2
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2048
LLM_MAX_TOKENS_SYNTHESIS=4096
JWT_SECRET=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=*
RATE_LIMIT=30/minute

# Auth0 backend verification (optional — false = HS256 shared-secret mode)
AUTH0_ENABLED=false
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.company-brain.example

# Self-serve Drive connector onboarding (Google OAuth web flow).
# Deployment-level OAuth client of type "Web application" — NOT the installed
# credentials.json used by headless runs. The redirect URI is the ORG-LESS
# callback URL and must be registered EXACTLY like this in the Google client:
#   https://<your-host>/api/v1/connectors/drive/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Where the callback redirects the browser back to (frontend base URL).
FRONTEND_URL=http://localhost:5173

# --- frontend (Vite env: frontend/.env or build environment) -----------------
# Auth0 Universal Login for the SPA. With VITE_AUTH0_DOMAIN unset the
# frontend shows the "Dev mode" paste-token screen instead.
# VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# VITE_AUTH0_CLIENT_ID=your-spa-client-id
# VITE_AUTH0_AUDIENCE=https://api.company-brain.example
AUTH0_JWKS_CACHE_TTL=3600

# Redis for background job queue (ARQ)
REDIS_URL=redis://localhost:6379/0

# Scheduled ingestion / synthesis (APScheduler, in-process)
SCHEDULE_ENABLED=false
SCHEDULE_INGEST_CRON=0 */6 * * *
SCHEDULE_SYNTHESIS_CRON=30 */6 * * *
SCHEDULE_USER_ID=scheduled

# Gunicorn workers
WEB_CONCURRENCY=4
WORKER_TIMEOUT=120